MeshCutoff 310 Ry

%block kgrid_Monkhorst_Pack
	12	0	0	0.0
	0	12	0	0.0
	0	0	2	0.0
%endblock kgrid_Monkhorst_Pack


%block PS.lmax
        C       2
%endblock PS.lmax

PAO.EnergyShift 300 meV                         
PAO.SplitNorm   0.15
PAO.BasisSize   DZP                             # SZ, DZ

XC.functional           GGA         # Exchange-correlation functional type # LDA = Local Density Approximation
XC.authors              PBE         # Exchange-correlation version # CA = Ceperley-Alder
#SpinPolarized         true          # Logical parameters are: yes or no
DM.Require.Energy.Convergence   .true.
DM.Energy.Tolerance             1.e-5 eV
MaxSCFIterations 3000
DM.MixingWeight 0.05
DM.NumberPulay  3
ElectronicTemperature 300 K
DM.Tolerance            1.d-4       # Tolerance in maximum difference

SolutionMethod Diagon                           # OrderN or Diagon
MD.TypeOfRun       CG               # We are going to perform a Conjugate Gradient (CG) minimization
#MD.VariableCell    .true.          # Is the lattice relaxed together with the atomic coordinates?
MD.MaxCGDispl      0.1 Ang          # Maximum atomic displacement in one CG step (Bohr)
MD.NumCGsteps      100              # Number of CG steps for coordinate optimization
MD.MaxStressTol    0.0005 eV/Ang**3 # Tolerance in the maximum stress in a MD.VariableCell CG optimi.
#%block GeometryConstraints         # Constraints impossed on
#   position   1   2                #   the position of atom 1
#   stress     4   5   6             #   the shear stresses
#%endblock GeometryConstraints

SaveElectrostaticPotential      .true.
SaveNeutralAtomPotential        .true.
SaveTotalPotential              .true.